# Compatibility copy. Prefer infra/.env.prod.example for the production runbook.
COMPOSE_PROJECT_NAME=performancefactory
COMPOSE_PROFILES=local-db

IMAGE_TAG=local
API_IMAGE=performancefactory-api:local
WEB_IMAGE=performancefactory-web:local
REDIS_IMAGE=redis:7.4-alpine

WEB_ORIGIN=https://performancefactory.example.com
NEXT_PUBLIC_API_BASE_URL=https://performancefactory.example.com/api

API_HOST_BIND=127.0.0.1
API_HOST_PORT=4000
WEB_HOST_BIND=127.0.0.1
WEB_HOST_PORT=3000

POSTGRES_IMAGE=postgres:16-bookworm
POSTGRES_USER=performancefactory
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
POSTGRES_DB=performancefactory
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# For a remote database: set COMPOSE_PROFILES= and replace DATABASE_URL.
REDIS_URL=redis://redis:6379
REDIS_SESSION_PREFIX=pf:sess:

SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_OPENSSL_RAND_HEX_32
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=

AI_PROVIDER=stub
AI_MODEL_PROPOSAL=gpt-5.4-mini
OPENAI_API_KEY=
GEMINI_MODEL_PROPOSAL=gemini-2.5-flash
GEMINI_API_KEY=
AI_DEBUG_PROMPT_LOG=false
SWAGGER_ENABLED=false
SWAGGER_PATH=docs
API_VERSION=0.1.0

GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=https://performancefactory.example.com/api/auth/google/callback
GOOGLE_OIDC_HOSTED_DOMAIN=
GOOGLE_OIDC_AUTO_LINK_VERIFIED_EMAIL=false
WEB_LOGIN_SUCCESS_URL=https://performancefactory.example.com/
WEB_LOGIN_FAILURE_URL=https://performancefactory.example.com/login

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Continuous athlete training lifecycle
TRAINING_LIFECYCLE_AUTOMATION=true
TRAINING_APPROVAL_MODE=AUTO
TRAINING_SESSION_APPROVAL_MODE=INHERIT_PLAN
COACH_AUTO_ASSIGNMENT=true
NEXT_CYCLE_AUTO_GENERATION=true
TRAINING_LIFECYCLE_WORKER=true

# Piani automatici per tutte le abilità abilitate dello sport
ABILITY_APPROVAL_MODE=AUTO
ABILITY_PLANS_WORKER=true
