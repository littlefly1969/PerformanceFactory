  @@index([userId, areaId])
}

/// Prompt AI_ASSESSMENT che legge il primo set dell'assessment e stima la R provvisoria.
/// Come per il prompt obiettivo, una sola configurazione e attiva; le altre sono bozze.
model AiAssessmentPromptConfig {
  id                    String   @id @default(uuid())
  name                  String   @unique
  basePrompt            String
  version               Int      @default(1)
  isActive              Boolean  @default(false)
  activePromptVersionId String?  @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdById           String?
  updatedById           String?

  /// EVALUATION valuta le risposte (R e confidence); CALIBRATION scrive le domande dei round; MICRO_TEST i micro-test su misura.
  kind                  String   @default("EVALUATION")

  activePromptVersion AiPromptVersion?  @relation("AiAssessmentPromptConfigActiveVersion", fields: [activePromptVersionId], references: [id])
  promptVersions      AiPromptVersion[] @relation("AiAssessmentPromptConfigVersions")

  @@index([isActive, version])
  @@index([kind, isActive])
}

/// Prima valutazione dell'assessment: R provvisoria per driver con confidence, mai P.
/// Ogni valutazione conserva fonte, versione del prompt, input e output validati.
model AssessmentEvaluation {
  id                String   @id @default(uuid())
  userId            String
  /// 1 = prima valutazione dell'assessment; le successive incrementano. Unico per atleta.
  sequence          Int      @default(1)
  status            String   @default("PROVISIONAL")
  source            String   @default("SELF_ASSESSMENT")
  summary           String
  overallConfidence Int
  /// Livello stimato (A2.5): BEGINNER, INTERMEDIATE, ADVANCED, COMPETITIVE, PRO. Assente nelle valutazioni precedenti.
  level             String?
  levelConfidence   Int?
  minScore          Float
  maxScore          Float
  provider          String
  model             String
  promptVersionId   String?
  promptHash        String
  inputJson         Json
  outputJson        Json
  latencyMs         Int?
  createdAt         DateTime @default(now())

  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptVersion AiPromptVersion?           @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  areas         AssessmentEvaluationArea[]
  round         CalibrationRound?
  scenarios     PotentialScenario[]
  microTestGenerations MicroTestGeneration[]

  @@unique([userId, sequence])
  @@index([userId, createdAt])
}

/// Scenario di potenziale P3/P6/P12 per driver, calcolato da un motore
/// sostituibile sulla valutazione consolidata. Un nuovo calcolo (nuova
/// valutazione o nuovo motore) crea nuove righe: le precedenti restano.
model PotentialScenario {
  id            String         @id @default(uuid())
  userId        String
  evaluationId  String
  areaId        String
  horizon       ProgramHorizon
  /// R di partenza, nella scala della valutazione.
  current       Float
  value         Float
  confidence    Int
  assumptions   Json
  engine        String
  engineVersion String
  /// true finché il motore non è quello definitivo della Parte C.
  provisional   Boolean
  computedAt    DateTime       @default(now())

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluation AssessmentEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  area       Area                 @relation(fields: [areaId], references: [id])

  @@unique([evaluationId, engine, engineVersion, horizon, areaId])
  @@index([userId, computedAt])
  @@index([areaId])
}

model AssessmentEvaluationArea {
  id            String @id @default(uuid())
  evaluationId  String
  areaId        String
  score         Float
  confidence    Int
  rationale     String
  evidenceGaps  Json
  /// Commitment profile dell'area (A2.2): LOW, MEDIUM, HIGH o UNKNOWN.
  commitment    String?

  evaluation AssessmentEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  area       Area                 @relation(fields: [areaId], references: [id])

  @@unique([evaluationId, areaId])
  @@index([areaId])
}

// Pagamenti (Blueprint A4/A5): PROGRAM_HORIZON e BILLING_CYCLE sono proprieta distinte.
enum ProgramHorizon {
  PROGRAM_3M
  PROGRAM_6M
  PROGRAM_12M
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum PaymentProviderKind {
  STUB
  STRIPE
}

enum PurchaseChannel {
  WEB
  IOS
  ANDROID
}

enum SubscriptionStatus {
  CHECKOUT_PENDING
  CHECKOUT_EXPIRED
  CHECKOUT_FAILED
  ACTIVE
  PAYMENT_GRACE
  PAUSED
  EXPIRED
}

// Prezzo della cadenza di pagamento, non di un livello di servizio (A5.1-A5.4).
// Parametrico da back office: i valori seminati sono le ipotesi A5-D01.
model BillingCyclePrice {
  billingCycle BillingCycle @id
  amountCents  Int
  currency     String       @default("eur")
  updatedAt    DateTime     @updatedAt
}

// Matrice PROGRAM_HORIZON x BILLING_CYCLE: quali combinazioni sono offerte (A5-D02).
model ProgramBillingOption {
  horizon      ProgramHorizon
  billingCycle BillingCycle
  isActive     Boolean        @default(true)
  updatedAt    DateTime       @updatedAt

  @@id([horizon, billingCycle])
}

model PaymentCustomer {
  id                 String              @id @default(uuid())
  userId             String
  provider           PaymentProviderKind
  providerCustomerId String
  createdAt          DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerCustomerId])
}

model Subscription {
  id                     String              @id @default(uuid())
  userId                 String
  horizon                ProgramHorizon
  billingCycle           BillingCycle
  status                 SubscriptionStatus  @default(CHECKOUT_PENDING)
  provider               PaymentProviderKind
  purchaseChannel        PurchaseChannel     @default(WEB)
  amountCents            Int
  currency               String
  providerCheckoutId     String?
  checkoutUrl            String?
  checkoutExpiresAt      DateTime?
  providerSubscriptionId String?
  providerCustomerId     String?
  currentPeriodStart     DateTime?
  entitlementEndAt       DateTime?
  nextChargeAt           DateTime?
  cancelAtPeriodEnd      Boolean             @default(false)
  graceEndsAt            DateTime?
  programStartedAt       DateTime?
  programEndsAt          DateTime?
  endedAt                DateTime?
  // created dell'ultimo evento applicato: gli eventi piu vecchi sono scartati.
  lastProviderEventAt    DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  events PaymentEvent[]

  @@unique([provider, providerCheckoutId])
  @@unique([provider, providerSubscriptionId])
  // Invariante in migrazione (indice parziale, non esprimibile in Prisma):
  // al massimo un abbonamento non terminale per utente.
  @@index([userId, status])
}

// Registro idempotente e auditabile degli eventi ricevuti dal provider.
model PaymentEvent {
  id                String              @id @default(uuid())
  provider          PaymentProviderKind
  providerEventId   String
  type              String
  // Esito sul modello PF: ACTIVATED, RENEWED, PAYMENT_RECOVERED, STALE...
  outcome           String?
  subscriptionId    String?
  payloadJson       Json
  providerCreatedAt DateTime?
  receivedAt        DateTime            @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([subscriptionId])
}

/// Circolo o partner territoriale attribuibile (Index, A2.11, A5.11-A5.13).
model Partner {
  id        String   @id @default(uuid())
  kind      String   @default("CLUB")
  /// Codice usato nei link e nei QR (?club=codice), minuscolo.
  code      String   @unique
  name      String
  city      String?
  isActive  Boolean  @default(true)
  /// Il circolo offre la lezione gratuita di gruppo (A4.8, A7.2); spento di default.
  freeLessonsEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributions UserAttribution[]
  freeLessons  FreeLesson[]
  lessonSeats  FreeLessonSeat[]
}

/// Provenienza dell'atleta: prima e ultima sorgente prima della registrazione (A6 ricostruito).
model UserAttribution {
  userId      String   @id
  anonymousId String?
  firstTouch  Json
  lastTouch   Json
  partnerId   String?
  referrerId  String?
  createdAt   DateTime @default(now())

  user     User     @relation("UserAttribution", fields: [userId], references: [id], onDelete: Cascade)
  partner  Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  referrer User?    @relation("ReferredUsers", fields: [referrerId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([referrerId])
  @@index([anonymousId])
}

/// Evento di prodotto append-only (A7.9 event-first analytics).
model AnalyticsEvent {
  id          String   @id @default(uuid())
  name        String
  occurredAt  DateTime
  receivedAt  DateTime @default(now())
  anonymousId String?
  userId      String?
  /// UUID scelto dal browser per ogni evento: un reinvio non crea un secondo evento.
  eventId     String?  @unique
  /// CLIENT (browser) o SERVER.
  origin      String
  properties  Json     @default("{}")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([name, occurredAt])
  @@index([userId, occurredAt])
  @@index([anonymousId, occurredAt])
}

/// Funzione rilasciabile prima ai beta tester, poi a una percentuale di utenti, poi a tutti.
model FeatureFlag {
  key            String   @id
  description    String
  enabled        Boolean  @default(false)
  betaTesters    Boolean  @default(true)
  rolloutPercent Int      @default(0)
  updatedAt      DateTime @updatedAt
  updatedById    String?

  updatedBy User? @relation("FeatureFlagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model FeatureFlagChange {
  id        String   @id @default(uuid())
  flagKey   String
  /// Null solo se l'account dell'autore è stato cancellato.
  actorId   String?
  before    Json?
  after     Json
  createdAt DateTime @default(now())

  actor User? @relation("FeatureFlagChangeActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([flagKey, createdAt])
  @@index([actorId])
}

/// Registro dei beta tester: chi entra o esce dal pubblico dei rilasci in beta.
model BetaTesterChange {
  id        String   @id @default(uuid())
  userId    String
  actorId   String?
  before    Boolean
  after     Boolean
  createdAt DateTime @default(now())

  user  User  @relation("BetaTesterChangeUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("BetaTesterChangeActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([actorId])
}

/// Calibrazione gratuita (A4.3, A4.6): dopo la prima valutazione R e confidence si
/// affinano a round fino alla soglia di confidence o all'assessment di chiusura.
/// Stato del percorso, separato da abbonamento ed engagement.
model AthleteCalibration {
  userId           String    @id
  /// FREE_CALIBRATING, FREE_LEVEL_ESTIMATED, CALIBRATION_COMPLETED
  status           String    @default("FREE_CALIBRATING")
  startedAt        DateTime
  deadlineAt       DateTime
  levelEstimatedAt DateTime?
  completedAt      DateTime?
  /// CONFIDENCE_REACHED, CLOSING_ASSESSMENT oppure DEADLINE_REACHED
  completionReason String?
  /// Lease di un'operazione in corso (generazione domande o valutazione).
  operationAt      DateTime?
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, deadlineAt])
}

/// Un round di domande scritte dall'AI sui driver con confidence più bassa.
/// Le risposte producono una nuova AssessmentEvaluation (sequence successiva).
model CalibrationRound {
  id              String    @id @default(uuid())
  userId          String
  sequence        Int
  /// ADAPTIVE oppure CLOSING
  kind            String    @default("ADAPTIVE")
  /// OPEN, EVALUATING, EVALUATED oppure EXPIRED (scadenza della calibrazione)
  status          String    @default("OPEN")
  questionsJson   Json
  answersJson     Json      @default("{}")
  provider        String
  model           String
  promptVersionId String?
  promptHash      String
  createdAt       DateTime  @default(now())
  answeredAt      DateTime?
  /// Proprietario della valutazione in corso: solo lui collega il risultato.
  evaluationToken String?
  evaluatedAt     DateTime?
  evaluationId    String?   @unique

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluation AssessmentEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  @@unique([userId, sequence])
  @@index([userId, status])
}

/// Parametri di back office della calibrazione (A4-D01 aperto): una sola riga.
model CalibrationConfig {
  id                       String   @id @default("default")
  confidenceThreshold      Int      @default(70)
  levelConfidenceThreshold Int      @default(50)
  maxDays                  Int      @default(30)
  closingDay               Int      @default(25)
  questionsPerDriver       Int      @default(2)
  driversPerRound          Int      @default(2)
  minHoursBetweenRounds    Int      @default(20)
  /// Programma (baseline e piano) prima del paywall per chi è in calibrazione.
  /// Decisione 13 aperta; Blueprint A4.6: no, quindi spento di default.
  programBeforePaywall     Boolean  @default(false)
  updatedAt                DateTime @updatedAt
  updatedById              String?

  updatedBy User? @relation("CalibrationConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Parametri di back office della lezione gratuita e dei crediti di interazione
/// (A4-D04, A8-D02 aperti): una sola riga. I crediti non sono Token PF.
model FreeLessonConfig {
  id                       String   @id @default("default")
  creditsToUnlock          Int      @default(100)
  creditsInitialAssessment Int      @default(30)
  creditsCalibrationRound  Int      @default(20)
  creditsMicroTest         Int      @default(10)
  microTestsPerDay         Int      @default(2)
  /// Giorni minimi tra la lezione e la scadenza della calibrazione: il feedback
  /// del coach deve arrivare prima che R si chiuda.
  minDaysBeforeDeadline    Int      @default(2)
  updatedAt                DateTime @updatedAt
  updatedById              String?

  updatedBy User? @relation("FreeLessonConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Ledger append-only dei crediti di interazione: una riga per evento sorgente.
/// Non si comprano, non si spendono e non sono il wallet Token PF (A4.11).
model InteractionCreditEntry {
  id        String   @id @default(uuid())
  userId    String
  /// INITIAL_ASSESSMENT, CALIBRATION_ROUND oppure MICRO_TEST
  action    String
  points    Int
  /// Chiave dell'evento sorgente (es. round:<id>): lo stesso evento vale una volta.
  sourceKey String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, createdAt])
}

/// Micro-test diagnostico scritto in back office (A3.9, A4.6): un esercizio
/// breve con un esito da riportare, non una seduta di programma.
model MicroTest {
  id           String   @id @default(uuid())
  areaId       String
  title        String
  instructions String
  /// Esiti selezionabili: [{ value, label, score }] nella scala della valutazione.
  optionsJson  Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  /// Atleta per cui l'AI ha scritto il test; nullo per il catalogo del back office.
  userId       String?
  generationId String?

  area        Area                  @relation(fields: [areaId], references: [id])
  completions MicroTestCompletion[]
  user        User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation  MicroTestGeneration?  @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([areaId, isActive])
  @@index([userId, isActive])
  @@index([generationId])
}

/// Un lotto di micro-test AI per atleta e valutazione: chi lo prende in carico
/// chiama l'AI una volta sola (token e lease), gli altri aspettano o ripiegano sul catalogo.
model MicroTestGeneration {
  id              String    @id @default(uuid())
  userId          String
  evaluationId    String
  /// PENDING, RUNNING, READY o FAILED.
  status          String    @default("PENDING")
  token           String?
  attempts        Int       @default(0)
  claimedAt       DateTime?
  provider        String?
  model           String?
  promptVersionId String?
  promptHash      String?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluation AssessmentEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  tests      MicroTest[]

  @@unique([userId, evaluationId])
  @@index([userId, status, createdAt])
}

model MicroTestCompletion {
  id          String   @id @default(uuid())
  userId      String
  microTestId String
  value       String
  completedAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  microTest MicroTest @relation(fields: [microTestId], references: [id], onDelete: Cascade)

  @@unique([userId, microTestId])
  @@index([userId, completedAt])
}

/// Lezione di padel di un'ora in gruppo da 4 presso un circolo partner (A4.8).
model FreeLesson {
  id              String   @id @default(uuid())
  partnerId       String
  coachId         String?
  startsAt        DateTime
  durationMinutes Int      @default(60)
  capacity        Int      @default(4)
  /// Livello del gruppo indicato dall'admin (gruppi omogenei).
  levelLabel      String?
  /// SCHEDULED, COMPLETED oppure CANCELLED
  status          String   @default("SCHEDULED")
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partner  Partner               @relation(fields: [partnerId], references: [id])
  coach    User?                 @relation("FreeLessonCoach", fields: [coachId], references: [id], onDelete: SetNull)
  seats    FreeLessonSeat[]
  feedback CoachLessonFeedback[]

  @@index([partnerId, startsAt])
  @@index([coachId, startsAt])
}

/// Il posto dell'atleta: uno per persona (A7.2 «1 seat / user»).
model FreeLessonSeat {
  userId                 String    @id
  partnerId              String
  lessonId               String?
  /// REQUESTED, ASSIGNED, ATTENDED, NO_SHOW oppure WITHDRAWN
  status                 String    @default("REQUESTED")
  /// L'atleta accetta che il coach della lezione veda nome, livello e driver.
  coachSharingAcceptedAt DateTime
  requestedAt            DateTime  @default(now())
  assignedAt             DateTime?
  updatedAt              DateTime  @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner Partner     @relation(fields: [partnerId], references: [id])
  lesson  FreeLesson? @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@index([lessonId, status])
  @@index([partnerId, status])
}

/// Feedback del coach: fonte distinta e autorevole che entra nella valutazione
/// successiva senza sovrascrivere le risposte dell'atleta (A4.8, A7.2).
model CoachLessonFeedback {
  id           String   @id @default(uuid())
  lessonId     String
  userId       String
  coachId      String?
  areaId       String
  /// 1-5, convertito nella scala della valutazione quando entra nell'input AI.
  rating       Int
  note         String?
  /// Valutazione che lo ha incorporato; null finché è in attesa.
  evaluationId String?
  createdAt    DateTime @default(now())

  lesson FreeLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  user   User       @relation("LessonFeedbackAthlete", fields: [userId], references: [id], onDelete: Cascade)
  coach  User?      @relation("LessonFeedbackCoach", fields: [coachId], references: [id], onDelete: SetNull)
  area   Area       @relation(fields: [areaId], references: [id])

  @@unique([lessonId, userId, areaId])
  @@index([userId, evaluationId])
}
