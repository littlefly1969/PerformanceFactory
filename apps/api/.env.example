DATABASE_URL="postgresql://postgres:postgres@localhost:5432/performancefactory"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/performancefactory_shadow"

NODE_ENV="development"
API_HOST="127.0.0.1"
API_PORT="4000"
API_HOST_PORT="4100"
WEB_HOST_PORT="3100"
WEB_ORIGIN="http://127.0.0.1:3000"

SESSION_SECRET="change-me-with-a-long-random-value"
SESSION_COOKIE_NAME="pf.sid"
SESSION_COOKIE_SECURE="false"
SESSION_COOKIE_SAME_SITE="lax"
SESSION_COOKIE_DOMAIN=""
SESSION_MAX_AGE_MS="28800000"
REDIS_URL="redis://localhost:6379"
REDIS_SESSION_PREFIX="pf:sess:"

GOOGLE_OIDC_CLIENT_ID=""
GOOGLE_OIDC_CLIENT_SECRET=""
GOOGLE_OIDC_REDIRECT_URI="http://127.0.0.1:4000/api/auth/google/callback"
GOOGLE_OIDC_HOSTED_DOMAIN=""
GOOGLE_OIDC_AUTO_LINK_VERIFIED_EMAIL="false"
WEB_LOGIN_SUCCESS_URL="http://127.0.0.1:3000/"
WEB_LOGIN_FAILURE_URL="http://127.0.0.1:3000/login"

AI_PROVIDER="stub"
AI_MODEL_PROPOSAL="gpt-5.4-mini"
OPENAI_API_KEY=""
GEMINI_MODEL_PROPOSAL="gemini-2.5-flash"
GEMINI_API_KEY=""
AI_DEBUG_PROMPT_LOG="false"
SWAGGER_ENABLED="true"
SWAGGER_PATH="docs"
API_VERSION="0.1.0"

# Continuous athlete training lifecycle
TRAINING_LIFECYCLE_AUTOMATION=true
TRAINING_APPROVAL_MODE=AUTO
TRAINING_SESSION_APPROVAL_MODE=INHERIT_PLAN
COACH_AUTO_ASSIGNMENT=true
NEXT_CYCLE_AUTO_GENERATION=true
TRAINING_LIFECYCLE_WORKER=true

# Piani automatici per tutte le abilità abilitate dello sport
ABILITY_APPROVAL_MODE=AUTO
ABILITY_PLANS_WORKER=true
