COMPOSE_PROJECT_NAME=performancefactory

IMAGE_TAG=2026-05-31
API_IMAGE=performancefactory-api:2026-05-31
WEB_IMAGE=performancefactory-web:2026-05-31
REDIS_IMAGE=redis:7.4-alpine

WEB_ORIGIN=https://performancefactory.example.com
NEXT_PUBLIC_API_BASE_URL=https://performancefactory.example.com/api

API_HOST_BIND=127.0.0.1
API_HOST_PORT=4000
WEB_HOST_BIND=127.0.0.1
WEB_HOST_PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
REDIS_URL=redis://redis:6379
REDIS_SESSION_PREFIX=pf:sess:

SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_OPENSSL_RAND_HEX_32
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=

AI_PROVIDER=stub
AI_MODEL_PROPOSAL=gpt-5.4-mini
OPENAI_API_KEY=
GEMINI_MODEL_PROPOSAL=gemini-2.5-flash
GEMINI_API_KEY=
AI_DEBUG_PROMPT_LOG=false
SWAGGER_ENABLED=false
SWAGGER_PATH=docs
API_VERSION=0.1.0

GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=https://performancefactory.example.com/api/auth/google/callback
GOOGLE_OIDC_HOSTED_DOMAIN=
GOOGLE_OIDC_AUTO_LINK_VERIFIED_EMAIL=false
WEB_LOGIN_SUCCESS_URL=https://performancefactory.example.com/
WEB_LOGIN_FAILURE_URL=https://performancefactory.example.com/login

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
